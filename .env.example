# ZippyMesh Production Configuration
# First-time: run `npm run setup` to generate .env (or copy this file and override).
#
# Secrets policy: Do NOT put OAuth client secrets or tokens in .env. They are provisioned
# in the dashboard and stored in DATA_DIR (oauth-secrets.json, db.json). Only the two
# bootstrap values below are read from env; override them for production.

# Main API Port
ZIPPY_PORT=20128

# ============================================================
# Network bind host (SECURE BY DEFAULT — loopback only)
# ============================================================
# ZippyMesh is privacy-first and local-first. By DEFAULT the server binds to
# 127.0.0.1 (loopback), so it is reachable only from this machine. This removes
# the remote attack surface entirely — nothing on your LAN can reach the node.
#
# Precedence: ZIPPY_BIND_HOST > HOST > 127.0.0.1 (default).
#
# Leave this commented to keep the secure loopback default:
# ZIPPY_BIND_HOST=127.0.0.1
#
# Set to 0.0.0.0 ONLY if you deliberately want to expose the node to other
# machines on your network — and ONLY behind authentication. With login
# disabled (requireLogin=false), a non-loopback bind lets any LAN host control
# and reconfigure this node WITHOUT a password (a loud warning is printed at
# startup). Before exposing: set requireLogin=true and a password via /setup.
# ZIPPY_BIND_HOST=0.0.0.0
#
# Docker users typically set HOST=0.0.0.0 so the container is reachable from the
# host; ensure login is enabled when you do.
# HOST=0.0.0.0
#
# ── Offline / privacy mode ──────────────────────────────────────────────────
# Hard-disable ALL non-provider outbound (telemetry + heartbeat to zippymesh.com),
# even if an account is connected. You can still use every AI provider you
# configure — ZippyMesh just won't talk to anything else. (Telemetry is already
# opt-in and off by default; this is a one-switch guarantee.) See docs/PRIVACY.md.
# ZIPPY_OFFLINE=true
#
# npm scripts: `npm run dev` / `npm start` bind 127.0.0.1. Use the explicit
# opt-in variants `npm run dev:lan` / `npm run start:lan` to bind 0.0.0.0.

# ── Reverse proxy ───────────────────────────────────────────────────────────
# Set ONLY when a reverse proxy you control sits in front of this node and
# rewrites X-Forwarded-For / X-Real-IP. The agent-token vault routes
# (/api/vault/read-with-token, /api/vault/list-with-token) then rate-limit
# per client address as reported by the proxy. Unset (default), those headers
# are ignored: Next.js exposes no socket address to route handlers, so a
# header the caller controls would let it choose its own rate-limit bucket.
# TRUST_PROXY=1

# Internal API base URL (for peers/filtered to fetch network status).
# When unset, uses http://localhost:ZIPPY_PORT. Set if status is on another host.
# INTERNAL_API_URL=http://localhost:20128

# P2P Discovery Port (UDP)
ZIPPY_DISCOVERY_PORT=20129

# P2P Beacon Interval (ms)

# Auth (required for production; override these)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_32_RANDOM_CHARS_MINIMUM
# Password is set via the setup wizard (/setup) and stored as a bcrypt hash
# in the user data directory. Do not set INITIAL_PASSWORD here.

# Custom Data Directory (Optional -- leave commented for normal installs)
#
# When UNSET (recommended), runtime data is stored in the OS-conventional
# per-user location, OUTSIDE the source tree:
#   Windows      %APPDATA%\zippy-mesh\
#   macOS/Linux  ~/.zippy-mesh/
# That directory holds db.json (bcrypt password hash, vault entries, provider
# credentials, tokens, usage data) -- things that should never live inside a
# git working copy or an app bundle that gets replaced on update.
#
# Setting DATA_DIR=./data puts all of that inside the repo/app folder instead.
# It is gitignored, so it won't be committed, but it is still the wrong home for
# user secrets: it is lost or clobbered when the app is reinstalled/updated, and
# it surprises anyone who clones the repo. Only set this for deliberate
# portable/CI/container setups, and prefer an ABSOLUTE path if you do:
#   DATA_DIR=/var/lib/zippy-mesh
# DATA_DIR=./data

# Plugins (comma-separated: llm, dvpn, compute). Default: llm
# ENABLED_PLUGINS=llm

# Node Branding
ZIPPY_NODE_NAME=ZippyNode

# ============================================================
# OAuth App-Level Credentials (required to enable OAuth flows)
# ============================================================
# These are APPLICATION credentials (same for all ZMLR users),
# not user credentials. Required once per deployment.
# See docs/oauth-setup.md for how to obtain these values.
#
# After setting these, user tokens are stored in DATA_DIR
# (oauth-secrets.json, encrypted) and survive rebuilds.
#
# Antigravity (Google Gemini Code Assist) OAuth app secret:
ANTIGRAVITY_CLIENT_SECRET=
#
# Gemini CLI OAuth app secret (used by both 'gemini' and 'gemini-cli' providers):
GEMINI_CLIENT_SECRET=
#
# iFlow OAuth app secret (only needed if using iFlow provider):
IFLOW_CLIENT_SECRET=

# Required: Shared bearer secret between this server and the Rust mesh sidecar
# (port 9480). Every sidecar route except /health and /version requires
# "Authorization: Bearer <SIDE_CAR_SECRET>". `npm run setup` (also run
# automatically before dev/build) generates and persists this value; the
# sidecar inherits it via environment when spawned by the app. If you run the
# sidecar separately (e.g. Docker), set the SAME value in its environment.
# With no secret set the sidecar only serves requests when NODE_ENV is
# development/test — in production it fails closed (401).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIDE_CAR_SECRET=

# Required: Secret key used to sign and verify API keys for the /v1/* endpoint.
# Without this, the router falls back to an ephemeral randomly-generated value that
# changes on every restart (a warning is logged). Set this before exposing ZMLR to
# any network or tool that needs a stable API key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_SECRET=

# Optional: ZippyCoin node RPC endpoint (Chain ID: 947). Default port 8545.
# ZPC_RPC_URL) to reach the node for balance, nonce, registration, and sends.

# DEV-ONLY faucet: 32-byte hex seed of a wallet that ALREADY holds ZIP (e.g. a
# local genesis/dev wallet). When set, the sidecar's POST /wallet/dev-fund (and
# /api/v1/wallet/fund) will sign a transfer FROM this wallet to fund fresh zpc1
# wallets so payments can be exercised end-to-end. Leave UNSET in production —
# the faucet is disabled (403) without it. No funds are ever fabricated.
# ZIPPY_DEV_FAUCET_SEED=

# Optional: Prompt cache settings
# Set to "false" to disable exact-match prompt caching entirely
PROMPT_CACHE_ENABLED=true
# Cache TTL in seconds (default: 3600 = 1 hour). Set to 0 for no expiry.
PROMPT_CACHE_TTL=3600

# Optional: ZippyVault agent token for the MCP server's vault tools (vault_get,
# vault_list, vault_store) when the MCP server runs as its own process. Issue a
# scoped token with POST /api/vault/tokens and put the raw value here (or in
# that process's environment). Over HTTP (/api/mcp) the token is sent per
# request in the x-zippyvault-token header instead — this variable is never
# consulted for HTTP callers.
# ZIPPYVAULT_TOKEN=

# Optional: OpenRouter API key — gives access to 300+ models via a single key
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=


# Community Edition
ZIPPYMESH_EDITION=community
