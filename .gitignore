#Ignore vscode AI rules
.github/instructions/codacy.instructions.md
README1.md

# Backup files
*.bak
# Kilo Code agent config — local-only, never ship
.kilocodemodes
# pnpm lock — project standardises on npm; gitignore stray pnpm artifacts
pnpm-lock.yaml
# Claude AI directories
.claude/

# Community dist
/community-dist/
# Explicitly exclude agent worktree scratchpads and release zips under community-dist
community-dist/.claude/
community-dist/.claude/worktrees/
community-dist/dist/*.zip

# Additional build artifacts
.voidspec/
experiments/zmlr-lite/node_modules/
sidecar/target/

# Large build artifacts
dist/*.zip

# User-specific runtime data (NEVER commit — contains credentials, tokens, playbooks, usage data)
data/
data/**
oauth-secrets.json
db.json
*.sqlite
*.sqlite-shm
*.sqlite-wal

# User playbook overrides (users create their own — templates live in src/shared/constants/defaults.js)
data/playbooks.json
data/playbooks-user.json

# Debug and session logs (may contain prompt/response data)
debug_log.txt
debug_session*.log
startup*.log
zippymesh.log

# Local credential stores (moved to ~/.openclaw per auth refactor)
scripts/creds.mjs
scripts/creds.js

# AutoClaw runtime state
.autoclaw/
